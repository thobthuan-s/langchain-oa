# LangchainOA — copy to .env and fill in. Never commit the filled file.

# ---------------------------------------------------------------------------
# Azure OpenAI (keyless — no API key is used)
# The caller needs the "Cognitive Services OpenAI User" role on the account.
# ---------------------------------------------------------------------------
AZURE_OPENAI_ENDPOINT=https://<your-aoai-resource>.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=<your-deployment-name>
AZURE_OPENAI_API_VERSION=2025-04-01-preview

# ---------------------------------------------------------------------------
# Azure read-only tools
# ---------------------------------------------------------------------------
AZURE_SUBSCRIPTION_ID=<your-subscription-id>

# ---------------------------------------------------------------------------
# Local development
# Set ENABLE_LOCAL_EVAL=true only on a developer machine. It exposes an
# unauthenticated /eval/invoke route. Keep it false everywhere else.
# ---------------------------------------------------------------------------
ENABLE_LOCAL_EVAL=true
LOG_LEVEL=INFO

# Work IQ local testing only. Each V2 server has a different OAuth audience.
# Leave empty in production — the agentic identity handles MCP auth per turn.
BEARER_TOKEN_MCP_SHAREPOINTREMOTESERVER=
BEARER_TOKEN_MCP_MAILTOOLS=
BEARER_TOKEN_MCP_CALENDARTOOLS=

# ---------------------------------------------------------------------------
# Entra Agent ID — stamped by `a365 setup all --aiteammate --m365`
# ---------------------------------------------------------------------------
TENANT_ID=
BLUEPRINT_APP_ID=
AUTH_HANDLER_NAME=AGENTIC

# ---------------------------------------------------------------------------
# Activity Protocol outbound replies — stamped by `a365 setup all`
#
# AUTHTYPE selects how this agent proves it is the Blueprint app:
#   ClientSecret         default. Simplest for prototypes, but the secret must
#                        be stored, rotated, and kept out of source control.
#   FederatedCredentials keyless and preferred for production. The Blueprint
#                        app trusts a managed identity, so no secret exists.
#                        Requires microsoft-agents-* 1.x — the pinned 0.5.3
#                        does not implement this auth type. Do not switch this
#                        variable alone; upgrade and revalidate the SDK and
#                        deployment plumbing first.
# ---------------------------------------------------------------------------
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__AUTHTYPE=ClientSecret
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__CLIENTID=
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__CLIENTSECRET=
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__TENANTID=
# Only for AUTHTYPE=FederatedCredentials — the managed identity client id.
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__FEDERATEDCLIENTID=

# ---------------------------------------------------------------------------
# Agent 365 observability
# Both flags are required for spans to reach Agent 365.
# ---------------------------------------------------------------------------
ENABLE_A365_OBSERVABILITY=false
ENABLE_A365_OBSERVABILITY_EXPORTER=false
ENABLE_A365_SENSITIVE_DATA=false
AGENT365OBSERVABILITY__TENANTID=
AGENT365OBSERVABILITY__AGENTBLUEPRINTID=

# ---------------------------------------------------------------------------
# Work IQ (optional tuning)
# ---------------------------------------------------------------------------
ENABLE_WORKIQ=true
WORKIQ_ENVIRONMENT_ID=
WORKIQ_CONSUMER_ID=
# Optional: comma-separated exact Work IQ tool names the model may call.
# Empty means any tool that passes the read-only name and annotation policy.
WORKIQ_ALLOWED_TOOLS=

# ---------------------------------------------------------------------------
# Microsoft Purview (optional)
# Capture also needs a DSPM collection policy with IsIngestionEnabled=true,
# scoped to the Agent Identity app id reported by protectionScopes.compute.
# Only uploadText (the prompt) can be blocked; responses are capture only.
# ---------------------------------------------------------------------------
ENABLE_PURVIEW=false
PURVIEW_ENFORCE_BLOCKS=false

# ---------------------------------------------------------------------------
# Email triage with Teams approval (optional)
# Triage runs for mail sent to (or forwarded to) the agent's own mailbox.
# Replies and escalations are sent only after an approver answers in Teams.
# APPROVERS: comma-separated Entra object IDs, for example the output of
#   az ad user show --id manager@contoso.com --query id -o tsv
# Each approver must message the agent once in Teams so it can reach them.
# ---------------------------------------------------------------------------
ENABLE_EMAIL_TRIAGE=false
EMAIL_TRIAGE_APPROVERS=
EMAIL_TRIAGE_ESCALATION_ADDRESS=
EMAIL_TRIAGE_INTERNAL_DOMAINS=
EMAIL_TRIAGE_AUTO_TAG=true
EMAIL_TRIAGE_APPROVAL_TTL_HOURS=72
# Ground draft replies with the read-only tools. External senders are skipped
# unless EMAIL_TRIAGE_RESEARCH_EXTERNAL=true.
EMAIL_TRIAGE_RESEARCH=true
EMAIL_TRIAGE_RESEARCH_EXTERNAL=false
# Partner mode: SharePoint URL of the customer records workbook. The agent user
# needs read access. Leave empty to disable.
CUSTOMER_WORKBOOK_URL=

# ---------------------------------------------------------------------------
# Durable state (optional). Blob service URL; the managed identity needs
# Storage Blob Data Contributor. Empty keeps state in memory.
# ---------------------------------------------------------------------------
STATE_STORAGE_BLOB_URL=
STATE_STORAGE_CONTAINER=agent-state
